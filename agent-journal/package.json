{
  "name": "pi-agent-learning-journal",
  "version": "1.0.0",
  "description": "A visual, interactive learning journal for understanding Pi Agent Runtime.",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src scripts --max-warnings=0",
    "validate:diagrams": "tsx scripts/validate-diagrams.ts",
    "test": "npm run validate:diagrams && npm run build && npm run lint"
  },
  "dependencies": {
    "mermaid": "^11.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.4.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "8.0.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SipengXie2024/pi-agent-learning-journal.git"
  },
  "license": "MIT"
}
